# Instantly API Key - Get from https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=your_instantly_api_key_here

# Optional: Namecheap API for domain purchasing
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# Optional: Cloudflare API for DNS management
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: Zoho Mail credentials for free inbox creation
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional: Microsoft Graph API for Outlook inbox creation
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
